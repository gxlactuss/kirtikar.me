# Base URL of the Kirtikar backend. No trailing slash, no /api/v1 suffix —
# the client appends the full path itself.
#   local:    http://localhost:8000
#   deployed: https://<user>-kirtikar-api.hf.space
VITE_API_BASE=http://localhost:8000

# Set to 1 to skip the network entirely and replay recorded fixtures.
# Equivalent to loading the site with ?demo=1.
VITE_FORCE_FIXTURES=0
