# Application Settings
PROJECT_NAME="Listing Factory API"
VERSION="0.1.0"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/listing_factory"

# Security / Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase Authentication (Provide either JSON content or file path; do not commit real secrets)
# Option 1: Inline service account JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option 2: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=""
# Option 3: project id only. Verifies token signature, audience and expiry
# against Google's public certificates with no secret. Revocation checking
# needs a service account and is skipped without one.
FIREBASE_PROJECT_ID="sih090"

# Media Storage
MEDIA_STORAGE_DIR="./media"
MAX_MEDIA_UPLOAD_SIZE=10485760

# Pipeline Configuration
PIPELINE_MAX_STAGE_ATTEMPTS=3

# AI & Speech Service API Keys
SARVAM_API_KEY="key here"
GEMINI_API_KEY="key here"
GEMINI_MODEL="gemini-3.5-flash"
# Raised because a multimodal extraction on the preferred model takes ~25s.
GEMINI_TIMEOUT_SECONDS=90
# Tried in order when the preferred model is overloaded, before any fallback
# to synthetic facts.
GEMINI_FALLBACK_MODELS="gemini-3-flash-preview,gemini-3.1-flash-lite"

# CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Demo deployment
#
# With DEMO_MODE on, a request carrying no Authorization header resolves to one
# shared seller instead of being rejected. That is how the public site at
# kirtikar.me uses this API, and it is also what lets a processed photo load in
# a plain <img src>. Leave it off anywhere real artisans' listings live.
DEMO_MODE=false
DEMO_SELLER_NAME="Kirtikar Demo"
# Live runs per IST day across all visitors combined before the demo refuses. 0 is no
# limit. Every run spends Sarvam and Gemini credit, so do not disable this on a
# deployment that is reachable from the internet.
DEMO_MAX_RUNS_PER_DAY=10
